# ---------------------------------------------------------------------------
# Seeker I — variables d'environnement (template)
# Copier vers .env, puis remplir. NE JAMAIS committer .env.
#
# Tout ce qui commence par VITE_ est injecte dans le bundle et donc PUBLIC.
# Aucune cle secrete ici : ni service_role, ni cle Helius, ni cle IA.
# ---------------------------------------------------------------------------

# Solana — cluster cible (informatif ; le relais RPC tranche cote serveur)
VITE_SOLANA_NETWORK=devnet

# Supabase (cle anon uniquement — publique par conception, protegee par RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Relais IA (Phase 3)
VITE_AI_PROXY_URL=https://your-project.supabase.co/functions/v1/ai-proxy

# i18n
VITE_DEFAULT_LOCALE=en

# ---------------------------------------------------------------------------
# Secrets SERVEUR — a definir dans Supabase > Edge Functions > Secrets.
# NE JAMAIS les prefixer VITE_ ni les placer dans ce fichier.
#
#   HELIUS_API_KEY      cle Helius, consommee par rpc-proxy
#   SOLANA_CLUSTER      devnet | mainnet
#   ANTHROPIC_API_KEY   (Phase 3) consommee par ai-proxy
# ---------------------------------------------------------------------------
