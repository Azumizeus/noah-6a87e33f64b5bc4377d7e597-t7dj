# ---------------------------------------------------------------------------
# Seeker I — variables d'environnement (template)
# Copier vers .env, puis remplir. NE JAMAIS committer .env.
#
# Tout ce qui commence par VITE_ est injecte dans le bundle et donc PUBLIC.
# Aucune cle secrete ici : ni service_role, ni cle de fournisseur IA.
# ---------------------------------------------------------------------------

# Solana
VITE_SOLANA_NETWORK=devnet
# RPC dedie recommande : le RPC public rate-limite (429) des les premiers appels.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Supabase (cle anon uniquement — publique par conception, protegee par RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Relais IA (Phase 3) — les cles fournisseurs vivent cote Edge Function
VITE_AI_PROXY_URL=https://your-project.supabase.co/functions/v1/ai-proxy

# i18n
VITE_DEFAULT_LOCALE=en
